# ----------------------------------------
# Kia / Hyundai API login
# ----------------------------------------

# Region used by the Hyundai/Kia API library.
# 1 is typically Europe in your current setup.
KIA_REGION=1

# Brand used by the API library.
# 1 is your current Kia setting.
KIA_BRAND=1

# Your Kia account username/email.
KIA_USERNAME=your_email@example.com

# Your Kia account password.
KIA_PASSWORD=your_password_here
# To get token use
# mkdir -p /tmp/kia2 && cd /tmp/kia2
# curl -L -o bluelinktoken.py https://raw.githubusercontent.com/RustyDust/bluelink_refresh_token/refs/heads/main/bluelinktoken.py
# python3 -m venv .venv
# source .venv/bin/activate
# pip3 install selenium requests curl_cffi pycryptodome

# python3 ./bluelinktoken.py --brand kia --username your@email.com --password yourpassword


# Optional Kia PIN used by some API actions.
KIA_PIN=1234


# ----------------------------------------
# App / database
# ----------------------------------------

# SQLite database file used to store raw trip points and derived trips.
DB_PATH=/data/kia_trip_logger.db

# Port where the Flask web app and API are exposed.
PORT=8000


# ----------------------------------------
# Polling behavior
# ----------------------------------------

# Slow/default poll interval in seconds.
# Used mainly when the car appears parked.
POLL_INTERVAL_SECONDS=900                    
# 120                    # 20 min daytime parked

NIGHT_PARKED_POLL_INTERVAL_SECONDS=3600       
# 60 min from 23:00 to 06:00 when parked
NIGHT_PARKED_START_HOUR=23
NIGHT_PARKED_END_HOUR=6

# Faster poll interval in seconds while movement is detected.
# Lower value=denser route points, but more API usage.
MOVING_POLL_INTERVAL_SECONDS=180              # 60
MOVING_POLL_INTERVAL_LOCAL_SECONDS=120        # 2 min under 70 km/h
MOVING_POLL_INTERVAL_HIGHWAY_SECONDS=600      # 10 min at/above 70 km/h
LOCAL_TRIP_MAX_SPEED_KMH=70

# After movement stops being detected, keep polling quickly
# for this many extra poll cycles before dropping back to slow polling.
RECENT_MOVEMENT_GRACE_POLLS=2


# ----------------------------------------
# Point storage / trip detection
# ----------------------------------------

# Minimum GPS movement in meters before a new point is worth storing.
# Smaller value = more map points, larger DB, more noise.
MIN_MOVEMENT_METERS=25

# Minimum odometer change in km before storing a new point.
# 0.05 km = 50 meters.
MIN_ODOMETER_DELTA_KM=0.05

# If the gap between two stored points is at least this many minutes,
# the app starts a new trip segment.
TRIP_GAP_MINUTES=2


# ----------------------------------------
# Reverse geocoding
# ----------------------------------------

# Convert coordinates into readable place names.
# true = enabled, false = disabled.
GEOCODE_ENABLED=true

# Cache geocode results by rounding coordinates to this many decimals.
# 3 decimals is roughly neighborhood-level caching.
GEOCODE_CACHE_DECIMALS=3

# Optional email sent to Nominatim for polite identification.
GEOCODE_EMAIL=your_email@example.com

# User-Agent used when calling the reverse geocoding service.
GEOCODE_USER_AGENT=kia-trip-logger/1.0 (your_email@example.com
